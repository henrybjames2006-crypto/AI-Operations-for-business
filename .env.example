# Copy to .env for local development. Never commit .env.
# Path of the SQLite database file (created by `python -m opsapp db upgrade`).
OPSAPP_DATABASE_PATH=data/opsapp.sqlite
# Random string used to sign the local session cookie. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPSAPP_SESSION_SECRET=change-me-to-a-random-string
# Port for the local web server. The server only ever binds to 127.0.0.1.
OPSAPP_PORT=8000
# Request reader: "mock" (rule-based, free, the default) or "anthropic" (a Claude model,
# paid per request). The AI only proposes what a request says; prices, customers and
# approvals are always decided by fixed rules.
OPSAPP_AI_PROVIDER=mock
# Only used when OPSAPP_AI_PROVIDER=anthropic. Create a key at console.anthropic.com and set
# a spending limit there too. Never commit the real key; .env is git-ignored.
OPSAPP_AI_API_KEY=
# claude-haiku-4-5 (cheapest), claude-sonnet-5-5 or claude-opus-5-5
OPSAPP_AI_MODEL=claude-haiku-4-5
# The app stops calling the AI and falls back to the rules once this much has been spent
# (estimated from token counts; not a billing cap).
OPSAPP_AI_BUDGET_USD=5.00
OPSAPP_AI_TIMEOUT_SECONDS=30
# Dispatcher: seconds between polls, and how long an action call may take.
OPSAPP_DISPATCH_POLL_SECONDS=2
OPSAPP_ACTION_TIMEOUT_SECONDS=10
OPSAPP_MAX_ATTEMPTS=3
