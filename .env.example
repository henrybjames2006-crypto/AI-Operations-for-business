# Copy to .env for local development. Never commit .env.
# Path of the SQLite database file (created by `python -m opsapp db upgrade`).
OPSAPP_DATABASE_PATH=data/opsapp.sqlite
# Random string used to sign the local session cookie. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPSAPP_SESSION_SECRET=change-me-to-a-random-string
# Port for the local web server. The server only ever binds to 127.0.0.1.
OPSAPP_PORT=8000
# Extraction adapter. Checkpoint 1 supports only the deterministic mock.
OPSAPP_AI_PROVIDER=mock
# Dispatcher: seconds between polls, and how long an action call may take.
OPSAPP_DISPATCH_POLL_SECONDS=2
OPSAPP_ACTION_TIMEOUT_SECONDS=10
OPSAPP_MAX_ATTEMPTS=3
